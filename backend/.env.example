# Copy to .env and fill in. NEVER commit the real .env file.
PORT=3000
NODE_ENV=development

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the SQLite file lives (default: backend/storage/odisha.db)
# DB_PATH=./storage/odisha.db

# Only needed if the frontend is hosted on a DIFFERENT origin
# (e.g. GitHub Pages). Comma-separated list.
# CORS_ORIGIN=https://your-username.github.io
